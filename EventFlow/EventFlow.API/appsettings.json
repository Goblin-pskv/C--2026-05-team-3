{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "JwtSettings": {
        "Issuer": "EvenFlow",
        "Audience": "EvenFlowUsers",
        "AccessTokenLifetimeMinutes": 15,
        "RefreshTokenLifetimeDays": 30
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microssoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "LuckyPennySoftware.MediarR.Licence": "Fatal"
            }
        }
    }
}
